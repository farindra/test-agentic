# Salin file ini jadi .env lalu isi nilai yang sesuai.
# JANGAN commit file .env yang asli — cukup .env.example ini yang masuk git.

# Port HTTP server (di-override jadi 8080 oleh docker-compose.yml saat deploy)
PORT=8080

# Lokasi file SQLite (di-override oleh docker-compose.yml saat deploy)
DB_PATH=./data/test-agentic.db

# Base URL publik aplikasi — dipakai buat nyusun URL webhook Telegram.
# WAJIB pakai domain asli + https di produksi, karena Telegram cuma mau
# ngirim webhook ke URL HTTPS yang bisa diakses publik.
PUBLIC_BASE_URL=https://test-agentic.farindra.com

# Secret buat nandatangan JWT session admin. Generate: openssl rand -base64 32
JWT_SECRET=change-me-jwt-secret

# Key AES-256 (base64, 32 byte) buat enkripsi API key provider & token bot
# Telegram sebelum disimpan ke SQLite. Generate: openssl rand -base64 32
ENCRYPTION_KEY=change-me-run-openssl-rand-base64-32

# Secret custom buat verifikasi webhook Telegram (header
# X-Telegram-Bot-Api-Secret-Token). Generate: openssl rand -hex 24
TELEGRAM_WEBHOOK_SECRET=change-me-telegram-webhook-secret

# Akun admin pertama — HANYA dipakai sekali saat tabel users masih kosong.
# Setelah user pertama dibuat, dua env ini diabaikan; ganti password lewat DB.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-strong-password

# Nama device yang muncul di WhatsApp -> Perangkat Tertaut
WA_DEVICE_NAME=Test Agentic Bot

# Kode negara default buat normalisasi nomor lokal (08xx -> 62xx)
WA_DEFAULT_COUNTRY_CODE=62
